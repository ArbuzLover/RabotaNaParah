<Page x:Class="RabotaNaParah.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RabotaNaParah.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
        Title="MainPage" Background="#FFB6DCEF">

    <StackPanel>
        <Label Content="СПИСОК ПИЦЦ" HorizontalAlignment="Center"></Label>
        <ListBox Width="400" Height="200" SelectionChanged="ListBox_SelectionChanged" >
            <ListBoxItem x:Name="ListBoxItem1" Content="Пицца ЧБД 4000тенге (Табми Масаев, Нурлан Сабуров, Лёха Щербаков, Макар, Эмир)"></ListBoxItem>
            <ListBoxItem x:Name="ListBoxItem2" Content="Зомби пицца 500солнышек (Мозге, подсолнух, зелёнка, стул, газонокосилка, горошек)"></ListBoxItem>
            <ListBoxItem x:Name="ListBoxItem3" Content="4 сира лям (Путин, Зеленский, Мадуро, Трамп)"></ListBoxItem>
            <ListBoxItem x:Name="ListBoxItem4" Content="Пицца Антонина 3дня (Панталоны, пенсия,сссыр )"></ListBoxItem>
            <ListBoxItem x:Name="ListBoxItem5" Content="Пицца Уральские пельмени 1000 (Андрей Рожков, Дмитрий Соколов, Дмитрий Брекоткин, Вячеслав Мясников, Максим Ярица, Александр Попов, Сергей Ершов, Илана Юрьева, Сергей Исаев, 5)"></ListBoxItem>
            <ListBoxItem x:Name="ListBoxItem6" Content="Пицца Mellstroy лямдвести (Сливы, виноград, яблоки на зелёных, арбузы, бананы, бабачай, кофебаба, бабпивка, чечевиный суп из семи залуп, салатик бурмалдатик, картошка фри, щавель, персик, шляпа)"></ListBoxItem>
        </ListBox>
        <Label Content="Итого: 0" HorizontalAlignment="Center" x:Name="Sum"></Label>
        <Button x:Name="NextPageButton" Content ="Дальше" Width="50" VerticalAlignment="Bottom" IsEnabled="False" Click="NextPageButton_Click"/>
    </StackPanel>
</Page>
