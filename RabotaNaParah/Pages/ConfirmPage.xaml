<Page x:Class="RabotaNaParah.Pages.ConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RabotaNaParah.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConfirmPage" Background="#FFB6DCEF">

    <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Пицца, которую вы выбрали: " x:Name="PizzaLabel" Width="300" TextWrapping="Wrap"/>
        <TextBlock Text="Размер, который вы выбрали: " x:Name="SizeLabel"/>
        <TextBlock Text="Добавка, которую вы выбрали: " x:Name="DopLabel"/>
        <TextBlock x:Name="SumTextBlock" Text="Итого: "/>
        <TextBlock Text="Имя" Margin="0,10,0,0"/>
        <TextBox x:Name="NameTextBox"></TextBox>
        <ComboBox Margin="0,5,0,0" x:Name="SOComboBox">
            <ComboBoxItem>При получении</ComboBoxItem>
            
            <ComboBoxItem>Картой</ComboBoxItem>
            <ComboBoxItem>СБП</ComboBoxItem>
        </ComboBox>
        <Button Content="Подтвердить" Margin="0,10" Click="Button_Click"></Button>
    </StackPanel>
</Page>
