<Window x:Class="RabotaNaParah.OptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabotaNaParah"
        mc:Ignorable="d"
        Title="OptionWindow" Height="450" Width="800">
    <StackPanel>
        <Button Content="Червоний" Background="Red" x:Name="RedButton" Click="RedButton_Click"/>
        <Button Content="Зелений" Background="Green" x:Name="GreenButton" Click="GreenButton_Click"/>
        <Button Content="синій" Background="Blue" x:Name="BlueButton" Click="BlueButton_Click"/>
        <Button Content="Жовтий" Background="Yellow" x:Name="YellowButton" Click="YellowButton_Click"/>
        <Slider x:Name="WidthSlider" Minimum="100" Maximum="2000" Value="800" ValueChanged="WidthSlider_ValueChanged"></Slider>
        <Slider x:Name="HeightSlider" Minimum="100" Maximum="1000"  Value="400"  ValueChanged="HeightSlider_ValueChanged"></Slider>

    </StackPanel>
</Window>
